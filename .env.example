# Site (leave unset or use a full URL — empty string breaks builds)
NEXT_PUBLIC_SITE_URL=https://pixelpitch.blog
NEXT_PUBLIC_CONTACT_EMAIL=hello@pixelpitch.blog

# Social (optional — leave blank / # until ready)
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_DISCORD_URL=

# Google AdSense (ads load only after cookie consent)
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_SLOT_LEADERBOARD=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_INFEED=
NEXT_PUBLIC_ADSENSE_SLOT_MIDARTICLE=

# Analytics (load only after cookie consent) — use one or both
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Newsletter — configure one provider
BUTTONDOWN_API_KEY=
FORMSPREE_NEWSLETTER_ID=
